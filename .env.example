# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun.
# .env git'e girmez; Claude bu dosyayı okumaz, betikler ortam değişkeni olarak kullanır.
# Anahtarları sohbete yapıştırmayın.

# NASA FIRMS (ücretsiz): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Istege bagli: HTTP User-Agent sonuna eklenen iletisim bilgisi (Overpass vb. sunuculara nezaket icin).
HATKALKANI_CONTACT=
